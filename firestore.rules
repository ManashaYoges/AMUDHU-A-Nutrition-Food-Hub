rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Prevents tampering with privileged fields like roles and permissions
    function doesNotModifyPrivilegedFields() {
      let privilegedFields = ['role', 'isAdmin', 'admin', 'permissions'];
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(privilegedFields);
    }

    // User profile documents at users/{userId}
    match /users/{userId} {
      // Authenticated users can read only their own profile
      allow read: if isOwner(userId);

      // Users can create their own profile during registration
      // Cannot self-assign admin or elevated privileges
      allow create: if isOwner(userId)
                    && request.resource.data.uid == userId
                    && (!('role' in request.resource.data) || request.resource.data.role == 'user');

      // Users can update their own profile, but cannot tamper with privileged fields or change uid
      allow update: if isOwner(userId)
                    && request.resource.data.uid == resource.data.uid
                    && doesNotModifyPrivilegedFields();

      // Users can delete only their own profile
      allow delete: if isOwner(userId);

      // User subcollections (e.g., meal_plans, plate_analyses, chat_history)
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Deny access to any other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
